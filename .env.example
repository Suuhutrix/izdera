# ─────────────────────────────────────────────────────────────
# İzdera — ortam değişkenleri (tümü opsiyonel; varsayılanlar çalışır)
# Vercel: Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Sitenin kanonik adresi (OpenSearch, sitemap, User-Agent için)
NEXT_PUBLIC_SITE_URL=https://izdera.com

# Virgülle ayrılmış SearXNG havuzu. JSON formatı AÇIK olmalı
# (searxng/settings.yml → search.formats: [html, json]).
# Yerelde `docker compose up -d` ile http://localhost:8080,
# canlıda Render/Koyeb/HF Spaces URL'nizi en başa koyun:
SEARXNG_INSTANCES=http://localhost:8080

# Özel SearXNG sunucunuz için opsiyonel gizli erişim anahtarı (X-SearXNG-Secret)
SEARXNG_SECRET=

# Tek istek zaman aşımı (ms) ve SearXNG fazının toplam bütçesi (ms)
SEARXNG_TIMEOUT_MS=2500
SEARCH_BUDGET_MS=4500

# Düşen instance'ın sıranın sonuna itilme süresi (ms)
SEARXNG_COOLDOWN_MS=300000

# Upstream yanıtlarının Next.js Data Cache süresi (sn)
SEARCH_REVALIDATE_SECONDS=600

# Marginalia bağımsız indeks anahtarı. "public" ortak ve günlük limitli;
# ücretsiz ticari olmayan anahtar için: contact@marginalia-search.com
MARGINALIA_API_KEY=public

# Opsiyonel: Resmi Brave Search API anahtarı (ayda 2.000 ücretsiz sorgu)
BRAVE_API_KEY=
